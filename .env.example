# ══════════════════════════════════════════════════════════════
#  Trading Bot v2 — Environment Variables
#  Copy to .env and fill in what you need.
# ══════════════════════════════════════════════════════════════

# ── Data Sources (at least one recommended) ──
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

ALPHA_VANTAGE_KEY=
POLYGON_API_KEY=

# ── Alerts ──
ALERT_METHOD=console
# Options: console, telegram, discord, email

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

DISCORD_WEBHOOK_URL=

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=

# ── Claude AI (optional — for natural language summaries) ──
ANTHROPIC_API_KEY=

# ── Paper Trading ──
PAPER_TRADE_ENABLED=false
