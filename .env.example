# ══════════════════════════════════════════════════════════════
#  Trading Bot v2 — Environment Variables
#  Copy to .env and fill in what you need.
# ══════════════════════════════════════════════════════════════

# ── Data Sources (at least one recommended) ──
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Paper account keys only. The client is hard-coded to paper=True; there is no live mode.

ALPHA_VANTAGE_KEY=
POLYGON_API_KEY=

# ── Alerts ──
ALERT_METHOD=console
# Options: console, telegram, discord, email

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

DISCORD_WEBHOOK_URL=

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=

# ── Claude AI (optional — advisory briefing; never touches orders) ──
ANTHROPIC_API_KEY=
# CLAUDE_MODEL wins; ANTHROPIC_MODEL is accepted as an alias. Verify with: python main.py check-llm
CLAUDE_MODEL=claude-opus-5-5
LLM_EFFORT=medium
# LLM_REFUSAL_FALLBACK: default | off
LLM_REFUSAL_FALLBACK=default
# Nightly briefing (D17): on/off switch and USD spend caps (UTC day / month), enforced from results/llm_calls.jsonl
LLM_BRIEFING_ENABLED=true
LLM_DAILY_BUDGET_USD=0.50
LLM_MONTHLY_BUDGET_USD=5.00

# ── Trading (paper only; D2: live trading is out of scope) ──
# TRADING_MODE: off (alert-only, default) | paper. Orders need paper AND PAPER_TRADE_ENABLED=true,
# AND a signal whose validation_status is order-eligible (none are in Phase 1), AND `risk init` done.
TRADING_MODE=off
PAPER_TRADE_ENABLED=false
# Signal-sleeve dollars. Risk sizing uses this, never the broker account equity.
SIGNAL_SLEEVE_EQUITY=10000
# Absolute $ cap per order (also capped at 10% of the sleeve)
MAX_ORDER_NOTIONAL=1000
# Persisted risk state, and the kill switch (create this file, or set KILL_SWITCH=1, to block all orders)
# STATE_DB_PATH=state/trading.db   # default is anchored to the repo; relative values resolve against it
# KILL_SWITCH_FILE=state/KILL

# ── API (server.py) ──
# If set, every /api/* route except /api/health requires "Authorization: Bearer <API_TOKEN>".
API_TOKEN=
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173
# Run with: uv run uvicorn server:app --host 127.0.0.1   (keep loopback unless API_TOKEN is set)
API_BIND_HOST=127.0.0.1
